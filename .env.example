# ═══════════════════════════════════════════════════════════════════════
# Stellar Payment Gateway — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── Node Environment ──────────────────────────────────────────────────
NODE_ENV=development

# ── Stellar / Soroban ─────────────────────────────────────────────────
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Relayer ───────────────────────────────────────────────────────────
# HMAC secret shared between webhook sender and receiver.
# Generate with: openssl rand -hex 32
RELAYER_HMAC_SECRET=change-me-to-a-random-hex-string

# ── API ───────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys (bearer tokens).
# Generate with: openssl rand -hex 24
API_KEYS=dev-api-key-change-me

# PostgreSQL connection string for the API service.
DATABASE_URL=postgres://stellar-payment-gateway:stellar-payment-gateway@localhost:5432/stellar-payment-gateway

# API server port (default: 4000)
PORT=4000

# ── Contract IDs (populate after deployment) ──────────────────────────
GOVERNANCE_TOKEN_ID=
GOVERNANCE_CONTRACT_ID=
TIMELOCK_CONTRACT_ID=
BRIDGE_CONTRACT_ID=
FACTORY_CONTRACT_ID=

# ── Web ───────────────────────────────────────────────────────────────
# Public-facing URL for the dashboard (used for SEO metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Docker (optional) ─────────────────────────────────────────────────
# Used by docker-compose.yml for local development with Postgres.
POSTGRES_USER=stellar-payment-gateway
POSTGRES_PASSWORD=stellar-payment-gateway
POSTGRES_DB=stellar-payment-gateway
