{
  "name": "@stellar-payment-gateway/cli",
  "version": "0.2.0",
  "private": true,
  "description": "Command-line interface for Stellar Payment Gateway operations",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "stellar-payment-gateway": "./src/index.ts"
  },
  "scripts": {
    "cli": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist .turbo",
    "build": "tsc --project tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@stellar-payment-gateway/eslint-config": "workspace:*",
    "@stellar-payment-gateway/tsconfig": "workspace:*",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "eslint": "^10.8.0"
  }
}
