{
  "name": "@stellar-payment-gateway/soroban-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript bindings for the Soroban contracts — generated by stellar-cli + scripts/generate-bindings.ts.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bindings/bridge.ts",
    "./factory": "./src/bindings/factory.ts",
    "./wrapper-token": "./src/bindings/wrapper-token.ts",
    "./payment": "./src/bindings/payment.ts",
    "./escrow": "./src/bindings/escrow.ts",
    "./invoice": "./src/bindings/invoice.ts",
    "./treasury": "./src/bindings/treasury.ts",
    "./fee-manager": "./src/bindings/fee-manager.ts",
    "./role-manager": "./src/bindings/role-manager.ts"
  },
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf src/bindings dist .turbo"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "@stellar-payment-gateway/shared": "workspace:*"
  },
  "devDependencies": {
    "@stellar-payment-gateway/eslint-config": "workspace:*",
    "@stellar-payment-gateway/tsconfig": "workspace:*",
    "typescript": "^5.6.3",
    "eslint": "^9.13.0"
  }
}
